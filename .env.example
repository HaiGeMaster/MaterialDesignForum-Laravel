# ==========================================
# 应用基础配置
# ==========================================
APP_NAME=MaterialDesignForum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai
APP_VERSION=26.10.14.150357

# 如上传的图片视频不显示，可能是public/storage 不存在。
# storage:link 是单独的事：如果 public/storage 不存在，可以在项目根目录手动创建：
# ln -s ../storage/app/public public/storage

# 默认语言
APP_LOCALE=en-US
# 回退语言（当前语言缺失时使用）
APP_FALLBACK_LOCALE=en-US
# 假数据生成语言
APP_FAKER_LOCALE=en-US

# 维护模式驱动（file / database）
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP 内置服务器 Worker 数
# PHP_CLI_SERVER_WORKERS=4

# ==========================================
# 密码加密
# ==========================================
# Bcrypt 加密轮数（越高越安全，也越慢）
BCRYPT_ROUNDS=12

# ==========================================
# 日志配置
# ==========================================
# 日志通道（stack=多通道, single=单文件, daily=按天切割）
LOG_CHANNEL=stack
# stack 驱动组合的通道
LOG_STACK=single
# 废弃方法警告通道
LOG_DEPRECATIONS_CHANNEL=null
# 日志级别（debug/info/notice/warning/error/critical/alert/emergency）
LOG_LEVEL=debug

# ==========================================
# 数据库配置
# ==========================================
# 数据库类型（mysql/pgsql/sqlite/sqlsrv）
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# 严格模式（关闭后允许无默认值字段插入）
DB_STRICT=false

# ==========================================
# Session 配置
# ==========================================
# Session 驱动（file/cookie/database/redis）
SESSION_DRIVER=file
# Session 有效期（分钟）
SESSION_LIFETIME=120
# 是否加密 Session 数据
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# 广播 / 文件 / 队列 / 缓存
# ==========================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 文件上传存储驱动：local / ftp / sftp / aliyun / upyun / qiniu / aws
MEDIA_DISK=local

# FTP（MEDIA_DISK=ftp；需在 PHP 中启用 ext-ftp）
MEDIA_FTP_HOST=
MEDIA_FTP_PORT=21
MEDIA_FTP_USERNAME=
MEDIA_FTP_PASSWORD=
MEDIA_FTP_ROOT=
MEDIA_FTP_PASSIVE=true
MEDIA_FTP_SSL=false
MEDIA_FTP_TIMEOUT=30
# 公开访问 URL 前缀，例如 https://files.example.com
MEDIA_FTP_URL=

# SFTP（MEDIA_DISK=sftp；密码或私钥认证二选一）
MEDIA_SFTP_HOST=
MEDIA_SFTP_PORT=22
MEDIA_SFTP_USERNAME=
MEDIA_SFTP_PASSWORD=
MEDIA_SFTP_PRIVATE_KEY=
MEDIA_SFTP_PASSPHRASE=
MEDIA_SFTP_ROOT=
MEDIA_SFTP_TIMEOUT=30
# 公开访问 URL 前缀，例如 https://files.example.com
MEDIA_SFTP_URL=

# 阿里云 OSS（MEDIA_DISK=aliyun）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
# 可选 CDN / 自定义访问域名，须包含 https://
ALIYUN_OSS_URL=

# 又拍云（MEDIA_DISK=upyun）
UPYUN_BUCKET=
UPYUN_OPERATOR=
UPYUN_PASSWORD=
UPYUN_DOMAIN=
UPYUN_PROTOCOL=https

# 七牛云 Kodo（MEDIA_DISK=qiniu）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 公开访问域名，须包含 https://
QINIU_DOMAIN=

# AWS S3（MEDIA_DISK=aws）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 队列驱动（database/redis/sync）
QUEUE_CONNECTION=database

# 缓存驱动（database/file/redis/memcached）。使用 file，避免 oauth 使用 cache 与数据库影响
# 注意：项目自建的 cache 表（name/value/create_time/life_time）仅供邮箱验证码使用，
# 并非 Laravel 框架的缓存表结构（key/value/expiration），因此 CACHE_STORE 不能设为 database，
# 否则 Microsoft OAuth 获取 OpenID 配置时会因列名不匹配报错
CACHE_STORE=file
# CACHE_PREFIX=

# ==========================================
# Memcached / Redis
# ==========================================
MEMCACHED_HOST=127.0.0.1

# Redis 客户端（phpredis/predis）
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# 邮件配置（SMTP）
# ==========================================
# 邮件驱动（smtp/sendmail/mailgun/log/array）
MAIL_MAILER=smtp
# 邮件协议（smtp/ssl/tls）
MAIL_SCHEME=null
# SMTP 服务器地址
MAIL_HOST=smtp.qq.com
# SMTP 端口（25/465-SSL/587-TLS）
MAIL_PORT=465
# 加密方式（ssl/tls/null）
MAIL_ENCRYPTION=ssl
# 发件邮箱账号
MAIL_USERNAME=
# 邮箱授权码（非登录密码）
MAIL_PASSWORD=
# 发件人地址
MAIL_FROM_ADDRESS=
# 发件人名称
MAIL_FROM_NAME="${APP_NAME}"

# 前端环境变量前缀
VITE_APP_NAME="${APP_NAME}"
VITE_CLARITY_PROJECT_ID=rgskmt7i7n

# ==========================================
# OAuth 第三方登录
# ==========================================
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=${APP_URL}/auth/github/callback

# Microsoft Azure OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=${APP_URL}/auth/microsoft/callback
# Azure 租户类型（common=所有用户, organizations=仅工作账号, consumers=仅个人账号, 或指定 tenant ID）
MICROSOFT_TENANT_ID=common

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Cookie 政策信息（正式发布前请将“请填写”项替换为真实信息）
COOKIE_POLICY_EFFECTIVE_DATE="2026-10-16"
COOKIE_POLICY_UPDATED_DATE="2026-10-16"
COOKIE_POLICY_VERSION=1.0
COOKIE_POLICY_COMPANY_NAME="${APP_NAME}"
COOKIE_POLICY_WEBSITE_DOMAIN="${APP_URL}"
COOKIE_POLICY_REGISTERED_ADDRESS="【广东省清远市清城区东城街道】"
COOKIE_POLICY_PRIVACY_EMAIL="【xbedrock@foxmail.com】"
COOKIE_POLICY_CF_CLEARANCE_DURATION="30 分钟至 1 年（取决于后台配置）"
COOKIE_POLICY_UI_LOCALE_DURATION="30 分钟至 1 年（取决于后台配置）"
COOKIE_POLICY_UI_THEME_DURATION="30 分钟至 1 年（取决于后台配置）"
COOKIE_POLICY_CLARITY_CLCK_DURATION="1 年"
COOKIE_POLICY_CLARITY_CLSK_DURATION="1 天"
COOKIE_POLICY_MUID_DURATION="13 个月（390 天）"
COOKIE_POLICY_EU_UK_LEGAL_BASIS_NOTE=
COOKIE_POLICY_EU_UK_TRANSFER_NOTE=
COOKIE_POLICY_MAXIMUM_RETENTION="13 个月"
COOKIE_POLICY_CONSENT_RETENTION="12 个月"
COOKIE_POLICY_CONTACT_PHONE="/"
COOKIE_POLICY_RESPONSE_PERIOD="15 个工作日"
COOKIE_POLICY_EU_UK_COMPLAINT_NOTE=
